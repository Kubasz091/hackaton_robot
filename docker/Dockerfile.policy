FROM huggingface/lerobot-gpu

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl libglib2.0-0 libegl1-mesa-dev ffmpeg \
    libusb-1.0-0-dev speech-dispatcher libgeos-dev portaudio19-dev \
    cmake pkg-config ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv

# Set up working directory
WORKDIR /lerobot

# Copy dependency files
COPY pyproject.toml .
COPY requirements-ubuntu.txt .

# Install dependencies (including i2rt if needed, though often better to mount or copy source)
# Here we assume we might need to install from the local context or just the base requirements
RUN uv pip install --system -r requirements-ubuntu.txt
RUN uv pip install --system ".[act,yam]"

# Copy source code
COPY src/ src/
COPY scripts/ scripts/

# Set python path
ENV PYTHONPATH=/lerobot/src:$PYTHONPATH

# Default command
CMD ["/bin/bash"]
